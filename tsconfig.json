{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@nailzify/core": ["packages/core/src/index.ts"],
      "@nailzify/core/*": ["packages/core/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "services/*/src/**/*.ts", "**/*.test.ts"],
  "exclude": ["node_modules", "**/dist", "cdk.out"]
}
